# Local environments
.venv/
venv/
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*

# Local editor configuration
.vscode/

# Raw and generated data
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Curated final figures are version controlled.
# Other generated figures remain ignored.
outputs/figures/*
!outputs/figures/.gitkeep
!outputs/figures/primary_cohort_deposition_trends.png
!outputs/figures/cohort_indexed_deposition_comparison.png

# Generated reports
outputs/reports/*
!outputs/reports/.gitkeep

cat >> .gitignore <<'EOF'

# Generated package metadata
src/*.egg-info/

# Locally extracted source report text
docs/source_context.txt
EOF

# Notebook checkpoints
.ipynb_checkpoints/